rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions enforcing Multi-Tenancy Security
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Root User Collection Rules (/users/{userId})
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User Task Groups Subcollection (/users/{userId}/groups/{groupId})
      match /groups/{groupId} {
        allow read, write: if isOwner(userId);
      }

      // User Tasks Subcollection (/users/{userId}/tasks/{taskId})
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
